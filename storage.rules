rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cards/{imageId} {
      // Anyone can upload card images (no auth required)
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/png');
    }
  }
}
